# Model
GEMINI_API_KEY=

# Relational / cache
DATABASE_URL=sqlite:///./enterprise_intelligence.db
REDIS_URL=redis://localhost:6379/0

# MongoDB - use MongoDB Atlas or another managed deployment in production.
# Leave empty to disable non-critical conversation/run persistence locally.
MONGODB_URL=
MONGODB_DATABASE=enterprise_intelligence
MONGODB_APP_NAME=enterprise-intelligence-runtime
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_RETRY_READS=true
MONGODB_RETRY_WRITES=true

# Security
ENABLE_AUTH=false
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
