{
  "title": "Enterprise Intelligence Runtime",
  "schemaVersion": 39,
  "panels": [
    {"type":"timeseries","title":"HTTP Request Rate","targets":[{"expr":"sum(rate(http_requests_total[5m]))"}]},
    {"type":"timeseries","title":"HTTP P95 Latency","targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))"}]},
    {"type":"timeseries","title":"LLM Errors","targets":[{"expr":"sum(rate(llm_errors_total[5m]))"}]},
    {"type":"timeseries","title":"Retrieval Latency","targets":[{"expr":"histogram_quantile(0.95, sum(rate(retrieval_latency_seconds_bucket[5m])) by (le))"}]}
  ]
}
